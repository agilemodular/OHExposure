# Copy to .env and replace every value. Never commit .env.
DB_OWNER_PASSWORD=replace-with-a-long-random-owner-password
APP_DB_PASSWORD=replace-with-a-different-long-random-password
NODE_ENV=production
COOKIE_SECURE=true
# Number of trusted proxy hops in front of the app (e.g. 1 behind a single load balancer). Leave empty if none.
TRUST_PROXY=
# Optional branding
BRAND_PRODUCT_NAME=Occupational Hygiene & Exposure Assurance
BRAND_ENDORSEMENT=by Assurentra
BRAND_OWNER=SHEQ Experts Limited
