# Copy to deploy/.env on the host (mode 600) or inject from the secrets manager. Never commit real values.
OHEA_DOMAIN=                 # e.g. exposure.example.com — to be confirmed (decision sheet D-H3)
ACME_EMAIL=                  # certificate expiry notices
DB_OWNER_PASSWORD=           # long random; used only for migrations, backups and operator scripts
APP_DB_PASSWORD=             # long random, different; least-privilege application role
FIELD_RECOVERY_KEK=          # openssl rand -base64 32 ; keep a copy in the secrets manager, separate from backups
ALERT_WEBHOOK_URL=           # to be confirmed (decision sheet D-H6): e-mail/chat/on-call relay
ALERT_WEBHOOK_SECRET=        # openssl rand -hex 32
SESSION_IDLE_MINUTES=120
LOGIN_IP_LIMIT=20
BACKUP_RETAIN_DAYS=35        # to be confirmed against the retention decision (G7)
# Option B (managed PostgreSQL): DATABASE_HOST=... DATABASE_PORT=5432 and remove the db service
