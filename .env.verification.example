# LOCAL VERIFICATION ONLY — disposable development defaults and placeholders. Never use these values for a real system.
# Copy to .env.verification, adjust, then `set -a; . ./.env.verification; set +a` before running verification/run-verification.sh.
#
# Superuser connection to a DISPOSABLE PostgreSQL 16 server (database "postgres"). The run drops and re-creates
# ohea_verify_test, ohea_verify_app, ohea_example_report, ohea_tr0607_scenario and ohea_tr08_scenario on it.
OHEA_PG_SUPER_URL=postgres://postgres:postgres_dev@localhost:55432/postgres
# Set to yes only after confirming the server above is disposable.
OHEA_CONFIRM_DISPOSABLE=
# Password of the least-privilege application role created by migration 002 (development default; the server refuses it in production).
OHEA_APP_PASSWORD=ohea_app_dev
# Optional: also run the automated desktop-browser checks (Python 3 + Playwright + Chromium). Not device testing.
OHEA_BROWSER=0
OHEA_PORT=3100
# Optional: evidence directory (default ../ohea-evidence-<commit>)
OHEA_EVIDENCE_DIR=
# Application settings used by the local server during the browser checks (development defaults).
NODE_ENV=development
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=120
